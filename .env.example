# ==============================================================================
# VECNAVERSE: Voice-to-Investigation Cybercrime Audio Intelligence
# Environment Configuration Template (.env.example)
# ==============================================================================

# Node / Application Environment
NODE_ENV=development
APP_ENV=local
PORT=3000

# ------------------------------------------------------------------------------
# Google Gemini API Credentials & Models (Server-Only)
# ------------------------------------------------------------------------------
# Obtain key at: https://aistudio.google.com/
# NEVER expose this key to browser bundles or client-side code.
GEMINI_API_KEY=your_gemini_api_key_here

# Approved Model Identifiers
# Recorded transcription & multimodal audio analysis model:
GEMINI_RECORDED_MODEL=gemini-2.5-flash
# Alternative audio analysis model candidate:
GEMINI_AUDIO_ANALYSIS_MODEL=gemini-2.5-flash
# Live streaming transcription model candidate:
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Feature Gates (Keep false unless explicitly authorized and tested)
GEMINI_CUE_ENABLED=true
LIVE_TRANSCRIPTION_ENABLED=true

# ------------------------------------------------------------------------------
# Media & Ingestion Constraints
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (500 MB default)
MAX_UPLOAD_BYTES=524288000
# Maximum allowed audio duration in seconds (1800s = 30 mins)
MAX_AUDIO_DURATION_SECONDS=1800
# Maximum concurrent analysis runs
MAX_ANALYSIS_CONCURRENCY=4
# Maximum retry attempts on transient failures
MAX_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Audio Retention & Privacy Controls
# ------------------------------------------------------------------------------
# Retention duration in hours before automated purge (24 hours default)
AUDIO_RETENTION_HOURS=24
# Local storage directory for uploads
UPLOAD_DIR=./uploads/audio

# ------------------------------------------------------------------------------
# Optional Cloud Storage / Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
AUDIO_BUCKET_NAME=case-audio-private
